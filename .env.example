# Node.js E-Commerce Microservices - Environment Variables Template
# Copy this file to .env and fill in the values

# =============================================================================
# JWT Secrets (REQUIRED)
# =============================================================================
# Generate strong secrets with: openssl rand -base64 32
# IMPORTANT: Use different secrets for each environment (dev/staging/prod)

JWT_SECRET=your-32-char-jwt-secret-here-change-this
JWT_REFRESH_SECRET=your-32-char-refresh-secret-here-change-this

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection settings

# Prisma connection string (combines all DB params)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/user_db?schema=public"

# Individual database parameters (backward compatibility)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=5
DB_POOL_MAX=20

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis cache and session storage

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Service URLs (API Gateway)
# =============================================================================
# Microservice endpoints

USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# =============================================================================
# Rate Limiting
# =============================================================================
# API rate limit configuration

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Application Settings
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# API Gateway
PORT=3000

# User Service
# PORT=3001

# =============================================================================
# JWT Token Expiry
# =============================================================================

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
#
# For production deployment:
#
# 1. Generate secure random secrets:
#    openssl rand -base64 32
#
# 2. Use environment-specific values:
#    - Different JWT secrets per environment
#    - Strong database passwords
#    - Redis password enabled
#
# 3. Set NODE_ENV=production
#
# 4. Adjust rate limits based on traffic
#
# 5. Use secrets management (AWS Secrets Manager, HashiCorp Vault)
#
