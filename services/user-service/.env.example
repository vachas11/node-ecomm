# Server Configuration
NODE_ENV=development
PORT=3001
SERVICE_NAME=user-service

# Database Configuration (PostgreSQL)
# Prisma connection string (used by Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/user_db?schema=public"

# Individual connection parameters (used by DatabasePool for raw SQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT Configuration (SECURITY: Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-must-be-different-from-jwt-secret-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# AWS Configuration (for production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
