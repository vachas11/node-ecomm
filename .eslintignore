# ESLint Ignore Patterns
# Files and directories that ESLint should skip

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Coverage reports
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Minified files
*.min.js
*.min.mjs

# Environment files
.env
.env.*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# MAANG Interview: Why ignore dist/ folder?
# A: "dist/ contains COMPILED JavaScript. We lint the SOURCE TypeScript files,
#     not the output. Linting compiled code would show errors from the
#     TypeScript compiler's output, not our code."
